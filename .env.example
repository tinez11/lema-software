# Copy this file to .env and fill in real values. .env is gitignored.

# Central Postgres connection string used by Prisma (server-only).
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Signs the PIN-unlock session cookie (lib/auth/unlock.ts). Server-only.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PIN_UNLOCK_SECRET=""

# Clerk. Written by `clerk init`; values come from the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Clerk webhook signing secret, from the endpoint you create in the Clerk
# dashboard (Webhooks → Add Endpoint → .../api/webhooks/clerk). Without it the
# webhook route rejects every payload.
CLERK_WEBHOOK_SIGNING_SECRET=""
